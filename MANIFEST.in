include README.md LICENSE THIRD_PARTY_NOTICES.md pyproject.toml
include .gitignore
recursive-include assets *.jpg
recursive-include skelebone *.py *.png *.gif
recursive-include partmm *.py *.md *.png *.gif
recursive-include experiments *.py *.yaml *.md
recursive-include experiments/backends LICENSE* NOTICE* requirements*.txt
recursive-include resources/partmm *.md *.json
recursive-include experiments/reproductions/results *.json
include experiments/reproductions/dressrecon_bob/LICENSE
recursive-include native *.h *.cpp *.txt *.cmake *.in *.py *.toml *.sh LICENSE
recursive-include scripts *.py *.sh
recursive-include .github *.yml
prune tests
prune docs
prune experiments/runs
prune .research
prune .native
prune outputs
prune resources/partmm/example
prune resources/partmm/ssdr
prune resources/partmm/reference
prune build
prune dist
prune native/pyssdr/build
prune native/curve_skeleton/build
global-exclude __pycache__ *.py[cod] *.so
